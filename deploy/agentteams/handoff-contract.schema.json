{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policyflow.local/schemas/agentteams-handoff-v1.json",
  "title": "PolicyFlow AgentTeams handoff envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "transport_status",
    "team_name",
    "run_id",
    "trace_id",
    "messages"
  ],
  "properties": {
    "contract_version": {"const": "policyflow-agentteams-handoff/v1"},
    "transport_status": {
      "enum": ["design_not_executed", "matrix_observed"]
    },
    "team_name": {"const": "policyflow-team"},
    "run_id": {"type": "string", "minLength": 3},
    "trace_id": {"type": "string", "minLength": 3},
    "messages": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "from_agent",
          "to_agent",
          "message_type",
          "task",
          "context_refs",
          "expected_output",
          "decision_boundary",
          "state_before",
          "state_after",
          "trace_link"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "from_agent": {"type": "string", "minLength": 3},
          "to_agent": {"type": "string", "minLength": 3},
          "message_type": {
            "enum": [
              "goal",
              "policy_query",
              "evidence_bundle",
              "execution_task",
              "execution_result",
              "verification_result"
            ]
          },
          "task": {"type": "string", "minLength": 8},
          "context_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 2}
          },
          "expected_output": {"type": "string", "minLength": 3},
          "decision_boundary": {"type": "string", "minLength": 8},
          "state_before": {"type": "string", "minLength": 3},
          "state_after": {"type": "string", "minLength": 3},
          "trace_link": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trace_id", "span_id"],
            "properties": {
              "trace_id": {"type": "string", "minLength": 3},
              "span_id": {"type": "string", "minLength": 3}
            }
          }
        }
      }
    }
  }
}
