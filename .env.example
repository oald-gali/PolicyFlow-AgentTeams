# PolicyFlow defaults to a fully deterministic, offline demo mode.
POLICYFLOW_RUNTIME_MODE=local-demo
POLICYFLOW_DB_PATH=work/policyflow.db
POLICYFLOW_APPROVAL_SECRET=replace-with-a-random-secret-before-non-demo-use

# Optional OpenAI-compatible model. The MVP does not require it to run.
POLICYFLOW_LLM_ENABLED=false
POLICYFLOW_LLM_BASE_URL=https://api.openai.com/v1
POLICYFLOW_LLM_MODEL=
POLICYFLOW_LLM_API_KEY=
